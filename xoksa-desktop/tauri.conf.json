{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XOKSA",
  "version": "2.9.10",
  "identifier": "app.xoksa.desktop",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "XOKSA",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "kozo2000",
    "copyright": "Copyright (c) 2026 Kozo2000 - MIT License",
    "externalBin": [
      "binaries/xoksa",
      "binaries/xoksa-setup"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "bannerPath": "wix/banner.bmp",
        "dialogImagePath": "wix/dialog.bmp"
      }
    }
  }
}
