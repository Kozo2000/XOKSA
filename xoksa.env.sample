# ===== Language =====
# LANG=en  # en | ja  (output language; default: en)

# ===== Analysis mode =====
# ANALYSIS_MODE=daily  # daily | 60m | 30m | 15m | 5m | 1m | weekly | monthly  (bar timeframe for analysis; default: daily)

# ===== API_KEY =====
BRAVE_API_KEY=

# ===== Technical thresholds =====
BUY_RSI=30.0    # RSI buy signal threshold (below = oversold; default: 30)
SELL_RSI=70.0   # RSI sell signal threshold (above = overbought; default: 70)
MACD_DIFF_LOW=2.0   # MACD histogram weak-signal boundary (default: 2.0)
MACD_DIFF_MID=10.0  # MACD histogram strong-signal boundary (default: 10.0)
MACD_DIFF_EXTREME=100.0  # MACD extreme divergence boundary with overbought RSI (default: 100.0)

# ===== MACD negative-zone flag =====
MACD_MINUS_OK=false  # true = allow buy signals even when MACD histogram is negative

# ===== Enable extended technical analysis (true/false) =====
EMA=True
SMA=True
FIBONACCI=True
STOCHASTICS=True
ADX=True
ROC=True
BOLLINGER=True
VWAP=True
ICHIMOKU=True

# ===== Weight settings for each indicator =====
# Higher value = stronger influence on the composite score. Default: 1.0–2.0.
WEIGHT_BASIC=2.0        # RSI + MACD base indicators (weighted higher by default)
WEIGHT_EMA=1.0
WEIGHT_SMA=1.0
WEIGHT_BOLLINGER=1.0
WEIGHT_ROC=1.0
WEIGHT_ADX=1.0
WEIGHT_STOCHASTICS=1.0
WEIGHT_FIBONACCI=1.0
WEIGHT_VWAP=1.0
WEIGHT_ICHIMOKU=1.0

# ===== Indicator calculation parameters =====
# Periods / multipliers used in the indicator math. Commented = use defaults.
# EMA_SHORT_PERIOD=5             # short EMA period (must be < EMA_LONG_PERIOD)
# EMA_LONG_PERIOD=20            # long EMA period
# SMA_SHORT_PERIOD=5            # short SMA period (must be < SMA_LONG_PERIOD)
# SMA_LONG_PERIOD=20           # long SMA period (also the volume-average window)
# ADX_PERIOD=14                # ADX smoothing period
# ROC_PERIOD=10                # rate-of-change lookback period
# STOCHASTICS_PERIOD=14        # stochastics %K period
# BOLLINGER_PERIOD=20          # Bollinger Band moving-average period
# BOLLINGER_STDDEV_MULTIPLIER=2.0  # Bollinger Band standard-deviation multiplier
# BB_BANDWIDTH_SQUEEZE_PCT=8.0 # bandwidth %% at/below which a squeeze warning is shown
# ICHIMOKU_TENKAN_PERIOD=9     # Ichimoku conversion line (must be < kijun)
# ICHIMOKU_KIJUN_PERIOD=26     # Ichimoku base line
# VWAP_PERIOD=14               # rolling VWAP window (non-intraday modes)
# FIBONACCI_NEUTRAL_RATIO=0.05 # Fibonacci neutral band, as a share of the 50%→38.2% distance (0.0-0.5)

# ===== Investment stance (buyer/seller/holder) =====
STANCE=holder  # buyer | seller | holder  (affects signal interpretation and prompt framing)

# ===== Chat mode settings (--chat) =====
# CHAT_DEFAULT_TICKER=    # ticker(s) loaded automatically when --chat is used without --ticker; comma-separated, up to 5 (e.g. AAPL or AAPL,MSFT,NVDA or 7203.T,6758.T)
# CHAT_ANALYSIS_MODE=daily # daily | 60m | 30m | 15m | 5m | 1m | weekly | monthly (default: follow ANALYSIS_MODE)
# CHAT_MEMORY=mid         # low | mid | high  (context budget per turn; low: 8K chars/2 turns, mid: 16K/4 turns, high: 32K/8 turns; default: mid)
# CHAT_GUARD=high         # high | mid | low  (investment-advice constraint strength; high=strictest/default)
# DEBATE=summary          # off | summary | claims  (keep bounded other-LLM opinions in chat for critical review; default: summary)
# AUTORELOAD=false        # true = enable auto-reload timer in intraday chat mode (disabled for non-intraday modes)
# AUTORELOAD_NOTIFY=false # true = print notification when auto-reload fires (default: silent)
# --- Response style session defaults (override at runtime with /depth, /scope, /shape, /cast) ---
# READ_DEPTH=mid              # shallow | mid | deep  (how far the reply reads INTO the given data; default: mid)
# KNOWLEDGE_SCOPE=mid         # narrow | mid | wide   (how far the reply reaches OUTSIDE the input for general knowledge; confirmed values stay input-only; default: mid)
# RESPONSE_SHAPE=talk        # talk | points | scenario  (answer form: conversational / key-point list / scenarios; default: talk)
# FORECAST_MODE=soft          # off | soft | bold  (forecasting strength; never rewrites confirmed values; default: soft)

# ===== LLM provider settings =====
llm_provider=openai
llm_timeout_seconds=120       # request timeout in seconds
llm_temperature=0.7           # response randomness (0.0=deterministic, 1.0=creative; default: 0.7)
llm_top_p=0.9                 # nucleus sampling probability mass (0.0–1.0; default: 0.9)
llm_max_output_tokens=16384    # maximum tokens in the LLM response
#EXTRA_NOTE=(optional supplemental text appended to all LLM prompts)

# ===== OpenAI settings =====
OPENAI_API_KEY=
openai_model=gpt-5.6-terra

# ===== Gemini settings =====
GEMINI_API_KEY=
gemini_model=gemini-3.5-flash

# ===== Claude settings =====
CLAUDE_API_KEY=
claude_model=claude-sonnet-5
claude_max_tokens=16384

# ===== Ollama settings (local LLM) =====
# Used when llm_provider=ollama. No API key required.
#
# Define each Ollama server with numbered keys (OLLAMA_1_ to OLLAMA_16_).
# The lowest-numbered entry that is defined becomes the startup default.
# Gaps are allowed — if OLLAMA_1 is absent, OLLAMA_2 is used as default.
# Switch at runtime with /llm ollama:<alias> in chat mode.
#
#OLLAMA_1_ALIAS=gpu1
#OLLAMA_1_HOST=127.0.0.1
#OLLAMA_1_PORT=11434
#OLLAMA_1_MODEL=llama3
#
#OLLAMA_2_ALIAS=gpu2
#OLLAMA_2_HOST=192.168.0.3
#OLLAMA_2_PORT=11434
#OLLAMA_2_MODEL=gemma4:e4b
#
# OLLAMA_TIMEOUT_SECONDS=300   # request timeout in seconds (default: 300)
# OLLAMA_TEMPERATURE=0.2       # response randomness (lower = more consistent; default: 0.2)
# OLLAMA_TOP_P=0.9             # nucleus sampling probability mass (0.0–1.0; default: 0.9)
# OLLAMA_TOP_K=40              # top-k sampling (number of candidate tokens; default: 40)
# OLLAMA_REPEAT_PENALTY=1.1    # penalty for repeating tokens (>1.0 reduces repetition; default: 1.1)
# OLLAMA_NUM_CTX=32768         # context window size in tokens sent to the model (default: 32768)
# OLLAMA_NUM_PREDICT=8192      # maximum tokens to generate in one response (default: 8192)
# OLLAMA_THINK=low             # thinking budget: low | medium | high — specify only for models that support it
# OLLAMA_SEED=42               # random seed for reproducible output (default: 42)
# OLLAMA_DEBUG=false           # true = print request/response details to stderr
# OLLAMA_NO_GUARD=false        # true = disable integrity check and pass model output through as-is
# OLLAMA_BENCH_MODELS=llama3,gpt-oss:20b  # comma-separated model list for /bench comparison
# OLLAMA_BENCH_FORMAT=table    # output format for /bench results: table | csv | json
# OLLAMA_KEEP_ALIVE=10m        # how long to keep the model loaded in memory after the last request
# ⚠️ Models in the 7B–13B class tend to over-apply constraints. 30B or larger recommended for chat mode.

# ===== News settings =====
NO_NEWS=false           # true = skip news fetch entirely
SHOW_NEWS=false         # true = print fetched news titles to terminal
NEWS_FILTER=false       # true = filter news to ticker-relevant articles only
NEWS_COUNT=30           # number of news articles to fetch (default: 30)
NEWS_FRESHNESS=pm       # freshness filter: pd=past day, pw=past week, pm=past month, py=past year
#CUSTOM_NEWS_QUERY=     # override the auto-generated news query string
NO_ALIAS=false          # true = ignore alias CSV for company name display

# ===== Log settings =====
SAVE_TECHNICAL_LOG=false  # true = save technical analysis results to a log file
LOG_FORMAT=json           # json | csv  (log file format)
LOG_DIR=log               # directory path for log output
CSV_APPEND=false          # true = append to existing CSV log instead of overwriting
LOG_FLAT=false            # true = write one flat JSON per analysis instead of nested structure

# ===== Character limits (LLM prompt construction) =====
MAX_NOTE_LENGTH=400         # max chars for the outlook note section in LLM prompt
MAX_SHORTTERM_LENGTH=200    # max chars for short-term indicator summary
MAX_MIDTERM_LENGTH=200      # max chars for mid-term indicator summary
MAX_NEWS_LENGTH=1000        # max chars for news section in LLM prompt
MAX_REVIEW_LENGTH=2000      # max chars for full review section in LLM prompt

# ===== Proxy settings =====
# HTTP/HTTPS proxy (CONNECT tunnel method)
# Note: HTTPS_PROXY is the setting name for "proxy for HTTPS traffic"; the proxy URL itself typically starts with http://.
# Example (IP address):  http://192.168.0.10:8080
# Example (hostname):    http://proxy.corp.example:8080
# Example (SOCKS5):      socks5://proxy.corp.example:1080
# Note: Authenticated proxy URLs (user:password@...) are not supported. Configure at OS level.
#HTTP_PROXY=
#HTTPS_PROXY=
# Hosts to bypass the proxy (comma-separated)
#NO_PROXY=127.0.0.1,localhost
# Note: Ollama (127.0.0.1) always bypasses the proxy in code; no setting is needed.

# ===== Debug options =====
DEBUG_PROMPT=false   # true = save the LLM prompt to a file instead of sending it
NO_LLM=false         # true = skip LLM call entirely (technical analysis only)

# ===== Alias CSV (company names per ticker) =====
# ALIAS_CSV=data_j.csv  # uncomment and set the CSV path if you need company name display

# ===== Fundamental supplementary data =====
# FUNDAMENTAL=false  # set true to always fetch fundamental data without --fundamental flag
# Japanese stocks (J-Quants API, v2). A single API key from the J-Quants dashboard.
# The V1 token auth (id/refresh token, email+password) was retired 2026-06-01.
#JQUANTS_API_KEY=

# US stocks (SEC EDGAR)
# User-Agent is required. Format: app-name email-address (no slashes)
# Example: SEC_USER_AGENT=xoksa admin@example.com
#SEC_USER_AGENT=

# ===== Chat notification (alerts) =====
# While `xoksa serve` runs, XOKSA can watch an intraday condition and push a
# one-line message to a chat platform. Define channels with NOTIFY_<n>_ (1–16)
# and rules with ALERT_<n>_ (1–16); a rule's NOTIFY value selects the channel.
#
# The channel SECRET (the webhook URL, or the LINE bot token) is a credential:
# it is stored ONLY in the OS keychain — set it with `xoksa --update-key` or the
# desktop settings, NEVER in this file.
#
# NOTIFY_<n>_KIND : slack | discord | gchat | line
# NOTIFY_<n>_NAME : label shown in /alert listings
# NOTIFY_<n>_TO   : LINE destination id (LINE only; unused by the webhook kinds)
#
#NOTIFY_1_KIND=slack
#NOTIFY_1_NAME=team
#
#NOTIFY_2_KIND=line
#NOTIFY_2_NAME=me
#NOTIFY_2_TO=U0123456789abcdef
#
# ALERT_<n>_TICKER  : symbol to watch (e.g. 7203.T, AAPL)
# ALERT_<n>_WHEN    : one condition, <indicator><op><number>, op = <= >= < >
#                     indicators: close rsi macd macd_signal ema_s ema_l sma_s
#                     sma_l bb_u bb_l pct_b adx stoch_k vwap volume score
# ALERT_<n>_MODE    : intraday bar to watch: 1m | 5m | 15m | 30m | 60m
# ALERT_<n>_NOTIFY  : channel number to fire (default: 1)
# ALERT_<n>_EXPLAIN : true = add a one-line LLM note (default: false)
#
#ALERT_1_TICKER=7203.T
#ALERT_1_WHEN=rsi<=30
#ALERT_1_MODE=5m
#ALERT_1_NOTIFY=1
#ALERT_1_EXPLAIN=false
